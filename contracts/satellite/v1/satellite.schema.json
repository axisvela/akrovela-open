{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axisvela.github.io/akrovela/contracts/satellite/v1/satellite.schema.json",
  "title": "AKROVELA Satellite Command Protocol v1",
  "x-contract-version": "v1",
  "x-contract-status": "reviewed",
  "x-protocol-version": "akrovela.satellite/v1",
  "$defs": {
    "ScopeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "MessageId": {"type": "string", "pattern": "^msg:[A-Za-z0-9._~-]+$"},
    "SessionId": {"type": "string", "pattern": "^session:[A-Za-z0-9._~-]+$"},
    "Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "DateTime": {"type": "string", "format": "date-time"},
    "EnvelopeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "message_type", "message_id", "session_id",
        "sequence", "tenant_id", "workspace_id", "site_id", "satellite_id",
        "source_epoch", "coordinator_id", "coordinator_epoch", "sent_at", "body"
      ],
      "properties": {
        "protocol_version": {"const": "akrovela.satellite/v1"},
        "message_type": {"type": "string", "enum": ["hello", "hello_ack", "resume", "resume_result", "submit", "submit_result", "status", "status_result", "cancel", "cancel_result", "receipt_batch", "receipt_ack", "pre_release", "pre_release_ack", "consumption_batch", "consumption_ack", "heartbeat"]},
        "message_id": {"$ref": "#/$defs/MessageId"},
        "session_id": {"$ref": "#/$defs/SessionId"},
        "sequence": {"type": "integer", "minimum": 1},
        "tenant_id": {"$ref": "#/$defs/ScopeId"},
        "workspace_id": {"$ref": "#/$defs/ScopeId"},
        "site_id": {"$ref": "#/$defs/ScopeId"},
        "satellite_id": {"$ref": "#/$defs/ScopeId"},
        "source_epoch": {"type": "integer", "minimum": 1},
        "coordinator_id": {"$ref": "#/$defs/ScopeId"},
        "coordinator_epoch": {"type": "integer", "minimum": 1},
        "sent_at": {"$ref": "#/$defs/DateTime"},
        "body": {"type": "object"}
      }
    },
    "ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "workspace_id", "site_id"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/ScopeId"},
        "workspace_id": {"$ref": "#/$defs/ScopeId"},
        "site_id": {"$ref": "#/$defs/ScopeId"}
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_boot_epoch", "robot_ref", "adapter", "adapter_version", "map_ref", "frame_id"],
      "properties": {
        "node_id": {"$ref": "#/$defs/ScopeId"},
        "node_boot_epoch": {"type": "integer", "minimum": 1},
        "robot_ref": {"type": "string", "pattern": "^robot:[A-Za-z0-9._~:/-]+$"},
        "adapter": {"const": "ros2-nav2"},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "map_ref": {"type": "string", "pattern": "^map:[A-Za-z0-9._~:/-]+@sha256:[a-f0-9]{64}$"},
        "frame_id": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "Validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "expires_at", "clock_domain", "max_clock_skew_ms", "revalidate_at_release"],
      "properties": {
        "not_before": {"$ref": "#/$defs/DateTime"},
        "expires_at": {"$ref": "#/$defs/DateTime"},
        "clock_domain": {"const": "authority-utc"},
        "max_clock_skew_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "revalidate_at_release": {"const": true}
      }
    },
    "ResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_ms", "max_goal_distance_m", "max_path_length_m", "max_speed_mps", "max_attempts", "max_retries", "max_payload_bytes"],
      "properties": {
        "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "max_goal_distance_m": {"type": "number", "minimum": 0, "maximum": 10000},
        "max_path_length_m": {"type": "number", "minimum": 0, "maximum": 100000},
        "max_speed_mps": {"type": "number", "minimum": 0, "maximum": 10},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "max_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "NavigatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "position_tolerance_m", "yaw_tolerance_rad", "behavior_tree", "planner_id", "controller_id"],
      "properties": {
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "yaw", "frame_id"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "yaw": {"type": "number"},
            "frame_id": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
          }
        },
        "position_tolerance_m": {"type": "number", "minimum": 0, "maximum": 10},
        "yaw_tolerance_rad": {"type": "number", "minimum": 0, "maximum": 3.15},
        "behavior_tree": {"const": "navigate_to_pose_w_replanning_and_recovery.xml"},
        "planner_id": {"const": "GridBased"},
        "controller_id": {"const": "FollowPath"}
      }
    },
    "SubmitBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_key", "attempt_id", "operation_type", "payload_digest",
        "binding_digest", "payload", "target", "mission_ref", "assignment_ref", "lease_ref",
        "fencing_token", "safety_envelope_ref", "authority_ref", "approval_ref",
        "validity", "resource_limits", "observation_refs",
        "idempotency_retention_seconds", "dispatch_not_after", "contract_mode"
      ],
      "properties": {
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "operation_type": {"const": "ros2.nav2.navigate_to_pose@1"},
        "payload_digest": {"$ref": "#/$defs/Digest"},
        "binding_digest": {"$ref": "#/$defs/Digest"},
        "payload": {"$ref": "#/$defs/NavigatePayload"},
        "target": {"$ref": "#/$defs/Target"},
        "mission_ref": {"type": "string", "pattern": "^mission:[A-Za-z0-9._~:/-]+$"},
        "assignment_ref": {"type": "string", "pattern": "^assignment:[A-Za-z0-9._~:/-]+$"},
        "lease_ref": {"type": "string", "pattern": "^lease:[A-Za-z0-9._~:/-]+$"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "safety_envelope_ref": {"type": "string", "pattern": "^safe:[A-Za-z0-9._~:/-]+$"},
        "authority_ref": {"type": "string", "pattern": "^grant:[A-Za-z0-9._~:/-]+$"},
        "approval_ref": {"type": "string", "pattern": "^approval:[A-Za-z0-9._~:/-]+$"},
        "validity": {"$ref": "#/$defs/Validity"},
        "resource_limits": {"$ref": "#/$defs/ResourceLimits"},
        "observation_refs": {"type": "array", "maxItems": 0},
        "idempotency_retention_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "dispatch_not_after": {"$ref": "#/$defs/DateTime"},
        "contract_mode": {"const": "fixture"}
      }
    },
    "SubmitResultBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "attempt_id", "command_id", "status", "accepted_at", "source_epoch"],
      "properties": {
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "command_id": {"type": "string", "pattern": "^cmd:[A-Za-z0-9._~-]+$"},
        "status": {"type": "string", "enum": ["durably_accepted", "rejected"]},
        "reason": {"type": "string"},
        "accepted_at": {"$ref": "#/$defs/DateTime"},
        "source_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "CancelBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "attempt_id", "cancel_request_id", "reason_code", "client_requested_at", "deadline_ms"],
      "properties": {
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "cancel_request_id": {"type": "string", "pattern": "^cancel:[A-Za-z0-9._~-]+$"},
        "reason_code": {"type": "string", "enum": ["operator_request", "timeout", "safety", "other"]},
        "client_requested_at": {"$ref": "#/$defs/DateTime"},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 300000}
      }
    },
    "CancelResultBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancel_request_id", "status", "asserted_at"],
      "properties": {
        "cancel_request_id": {"type": "string", "pattern": "^cancel:[A-Za-z0-9._~-]+$"},
        "status": {"type": "string", "enum": ["cancel_requested", "cancel_rejected", "local_stop_asserted", "cancel_unknown"]},
        "confirmation_source": {"type": "string", "enum": ["safety_authority", "observation", "none"]},
        "confirmation_ref": {"type": "string"},
        "asserted_at": {"$ref": "#/$defs/DateTime"}
      }
    },
    "ReceiptBatchBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satellite_id", "receipts"],
      "properties": {
        "satellite_id": {"$ref": "#/$defs/ScopeId"},
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["satellite_receipt_id", "operation_key", "attempt_id", "receipt_type", "sequence", "digest", "emitted_at"],
            "properties": {
              "satellite_receipt_id": {"type": "string", "pattern": "^satreceipt:[A-Za-z0-9._~-]+$"},
              "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
              "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
              "receipt_type": {"type": "string", "enum": ["admission", "execution", "cancellation", "evidence", "repair"]},
              "sequence": {"type": "integer", "minimum": 1},
              "digest": {"$ref": "#/$defs/Digest"},
              "emitted_at": {"$ref": "#/$defs/DateTime"},
              "execution_index": {"type": "integer", "minimum": 1},
              "repeat_of_attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"}
            }
          }
        }
      }
    },
    "HeartbeatBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "queue_depth"],
      "properties": {
        "state": {"type": "string", "enum": ["resuming", "draining", "ready", "degraded"]},
        "queue_depth": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "HelloBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_min", "protocol_max", "capabilities"],
      "properties": {
        "protocol_min": {"type": "string"},
        "protocol_max": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "HelloMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "hello"}, "body": {"$ref": "#/$defs/HelloBody"}}, "required": ["message_type", "body"]}]},
    "SubmitMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "submit"}, "body": {"$ref": "#/$defs/SubmitBody"}}, "required": ["message_type", "body"]}]},
    "SubmitResultMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "submit_result"}, "body": {"$ref": "#/$defs/SubmitResultBody"}}, "required": ["message_type", "body"]}]},
    "CancelMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "cancel"}, "body": {"$ref": "#/$defs/CancelBody"}}, "required": ["message_type", "body"]}]},
    "CancelResultMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "cancel_result"}, "body": {"$ref": "#/$defs/CancelResultBody"}}, "required": ["message_type", "body"]}]},
    "ReceiptBatchMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "receipt_batch"}, "body": {"$ref": "#/$defs/ReceiptBatchBody"}}, "required": ["message_type", "body"]}]},
    "HeartbeatMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "heartbeat"}, "body": {"$ref": "#/$defs/HeartbeatBody"}}, "required": ["message_type", "body"]}]},
    "StatusBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "attempt_id"],
      "properties": {
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"}
      }
    },
    "StatusResultBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_key", "attempt_id", "state", "updated_at"],
      "properties": {
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "state": {"type": "string", "enum": ["received", "durably_accepted", "started", "completed", "failed", "confirmed_no_effect", "unknown", "rejected"]},
        "reason": {"type": "string"},
        "updated_at": {"$ref": "#/$defs/DateTime"}
      }
    },
    "HelloAckBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "accepted"],
      "properties": {
        "protocol_version": {"const": "akrovela.satellite/v1"},
        "accepted": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "ResumeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "last_uplink_sequence", "last_downlink_sequence", "source_epoch", "coordinator_epoch"],
      "properties": {
        "token": {"type": "string", "minLength": 1},
        "last_uplink_sequence": {"type": "integer", "minimum": 0},
        "last_downlink_sequence": {"type": "integer", "minimum": 0},
        "source_epoch": {"type": "integer", "minimum": 1},
        "coordinator_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "ResumeResultBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "drain_state", "uplink_high_water", "downlink_high_water"],
      "properties": {
        "accepted": {"type": "boolean"},
        "drain_state": {"type": "string", "enum": ["resuming", "draining", "ready"]},
        "uplink_high_water": {"type": "integer", "minimum": 0},
        "downlink_high_water": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      }
    },
    "ReceiptAckBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satellite_id", "acked_through_sequence"],
      "properties": {
        "satellite_id": {"$ref": "#/$defs/ScopeId"},
        "acked_through_sequence": {"type": "integer", "minimum": 0}
      }
    },
    "StatusMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "status"}, "body": {"$ref": "#/$defs/StatusBody"}}, "required": ["message_type", "body"]}]},
    "StatusResultMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "status_result"}, "body": {"$ref": "#/$defs/StatusResultBody"}}, "required": ["message_type", "body"]}]},
    "HelloAckMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "hello_ack"}, "body": {"$ref": "#/$defs/HelloAckBody"}}, "required": ["message_type", "body"]}]},
    "ResumeMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "resume"}, "body": {"$ref": "#/$defs/ResumeBody"}}, "required": ["message_type", "body"]}]},
    "ResumeResultMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "resume_result"}, "body": {"$ref": "#/$defs/ResumeResultBody"}}, "required": ["message_type", "body"]}]},
    "ReceiptAckMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "receipt_ack"}, "body": {"$ref": "#/$defs/ReceiptAckBody"}}, "required": ["message_type", "body"]}]},
    "ResourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_ms", "max_goal_distance_m", "max_path_length_m", "max_speed_mps", "max_payload_bytes"],
      "properties": {
        "max_duration_ms": {"type": "integer", "minimum": 1},
        "max_goal_distance_m": {"type": "number", "minimum": 0},
        "max_path_length_m": {"type": "number", "minimum": 0},
        "max_speed_mps": {"type": "number", "minimum": 0},
        "max_payload_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "ResourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "goal_distance_m", "path_length_m", "payload_bytes"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "goal_distance_m": {"type": "number", "minimum": 0},
        "path_length_m": {"type": "number", "minimum": 0},
        "payload_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "PreReleaseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id", "operation_key", "attempt_id", "operation_type",
        "payload_digest", "binding_digest", "payload", "target", "mission_ref",
        "assignment_ref", "lease_ref", "fencing_token", "safety_envelope_ref",
        "authority_ref", "approval_ref", "validity", "resource_limits",
        "observation_refs", "idempotency_retention_seconds", "dispatch_not_after",
        "contract_mode", "count_budget", "resource_budget"
      ],
      "properties": {
        "allocation_id": {"type": "string", "pattern": "^alloc:[A-Za-z0-9._~-]+$"},
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "operation_type": {"const": "ros2.nav2.navigate_to_pose@1"},
        "payload_digest": {"$ref": "#/$defs/Digest"},
        "binding_digest": {"$ref": "#/$defs/Digest"},
        "payload": {"$ref": "#/$defs/NavigatePayload"},
        "target": {"$ref": "#/$defs/Target"},
        "mission_ref": {"type": "string", "pattern": "^mission:[A-Za-z0-9._~:/-]+$"},
        "assignment_ref": {"type": "string", "pattern": "^assignment:[A-Za-z0-9._~:/-]+$"},
        "lease_ref": {"type": "string", "pattern": "^lease:[A-Za-z0-9._~:/-]+$"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "safety_envelope_ref": {"type": "string", "pattern": "^safe:[A-Za-z0-9._~:/-]+$"},
        "authority_ref": {"type": "string", "pattern": "^grant:[A-Za-z0-9._~:/-]+$"},
        "approval_ref": {"type": "string", "pattern": "^approval:[A-Za-z0-9._~:/-]+$"},
        "validity": {"$ref": "#/$defs/Validity"},
        "resource_limits": {"$ref": "#/$defs/ResourceLimits"},
        "observation_refs": {"type": "array", "maxItems": 0},
        "idempotency_retention_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "dispatch_not_after": {"$ref": "#/$defs/DateTime"},
        "contract_mode": {"const": "fixture"},
        "count_budget": {"type": "integer", "minimum": 1, "maximum": 10},
        "resource_budget": {"$ref": "#/$defs/ResourceBudget"},
        "execution_model": {"type": "string", "enum": ["single_use", "satellite_attempts", "repeat_attempt"]},
        "resource_budget_mode": {"type": "string", "enum": ["per_execution", "aggregate"]},
        "ack_profile": {"type": "string", "enum": ["per_consumption", "batch"]},
        "exhaustion_profile": {"type": "string", "enum": ["infer", "explicit_fact"]},
        "capability_source": {"type": "string", "enum": ["persist_last_hello", "require_live_session", "caller_supplied"]}
      }
    },
    "PreReleaseAckBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation_id", "accepted", "persisted_at"],
      "properties": {
        "allocation_id": {"type": "string", "pattern": "^alloc:[A-Za-z0-9._~-]+$"},
        "accepted": {"type": "boolean"},
        "reason": {"type": "string"},
        "persisted_at": {"$ref": "#/$defs/DateTime"}
      }
    },
    "ConsumptionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumption_id", "allocation_id", "operation_key", "attempt_id", "consumed_at", "sequence", "digest"],
      "properties": {
        "consumption_id": {"type": "string", "pattern": "^consumption:[A-Za-z0-9._~-]+$"},
        "allocation_id": {"type": "string", "pattern": "^alloc:[A-Za-z0-9._~-]+$"},
        "operation_key": {"type": "string", "pattern": "^op:[A-Za-z0-9._~-]+$"},
        "attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "consumed_at": {"$ref": "#/$defs/DateTime"},
        "sequence": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/Digest"},
        "receipt_ref": {"type": "string"},
        "execution_index": {"type": "integer", "minimum": 1},
        "repeat_of_attempt_id": {"type": "string", "pattern": "^attempt:[A-Za-z0-9._~-]+$"},
        "resource_usage": {"$ref": "#/$defs/ResourceUsage"}
      }
    },
    "ConsumptionBatchBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satellite_id", "consumptions"],
      "properties": {
        "satellite_id": {"$ref": "#/$defs/ScopeId"},
        "consumptions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/ConsumptionBody"}}
      }
    },
    "ConsumptionAckBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satellite_id", "acked_through_sequence"],
      "properties": {
        "satellite_id": {"$ref": "#/$defs/ScopeId"},
        "acked_through_sequence": {"type": "integer", "minimum": 0},
        "results": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["consumption_id", "status"],
            "properties": {
              "consumption_id": {"type": "string", "pattern": "^consumption:[A-Za-z0-9._~-]+$"},
              "status": {"type": "string", "enum": ["accepted", "duplicate", "rejected"]},
              "reason": {"type": "string"}
            }
          }
        },
        "reason": {"type": "string"}
      }
    },
    "PreReleaseMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "pre_release"}, "body": {"$ref": "#/$defs/PreReleaseBody"}}, "required": ["message_type", "body"]}]},
    "PreReleaseAckMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "pre_release_ack"}, "body": {"$ref": "#/$defs/PreReleaseAckBody"}}, "required": ["message_type", "body"]}]},
    "ConsumptionBatchMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "consumption_batch"}, "body": {"$ref": "#/$defs/ConsumptionBatchBody"}}, "required": ["message_type", "body"]}]},
    "ConsumptionAckMessage": {"allOf": [{"$ref": "#/$defs/EnvelopeBase"}, {"type": "object", "properties": {"message_type": {"const": "consumption_ack"}, "body": {"$ref": "#/$defs/ConsumptionAckBody"}}, "required": ["message_type", "body"]}]},
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unsupported_version", "unauthenticated", "forbidden_identity",
        "forbidden_scope", "expired_dispatch", "stale_coordinator_epoch",
        "stale_source_epoch", "binding_conflict", "binding_digest_mismatch",
        "payload_digest_mismatch", "operation_key_binding_conflict",
        "operation_key_payload_conflict", "duplicate_in_progress",
        "message_replayed", "queue_full", "frame_too_large", "invalid_request",
        "cancel_not_possible", "unknown_outcome", "dependency_unavailable",
        "not_found", "approval_consumed", "stale_node_boot_epoch",
        "not_yet_valid", "expired", "reconciliation_required", "action_in_progress",
        "drain_required"
      ]
    }
  }
}
